<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#0A0B14</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0A0B14</item>
        <item name="android:statusBarColor">#0A0B14</item>
        <item name="android:navigationBarColor">#0A0B14</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#0A0B14</item>
        <item name="android:statusBarColor">#0A0B14</item>
        <item name="android:navigationBarColor">#0A0B14</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
